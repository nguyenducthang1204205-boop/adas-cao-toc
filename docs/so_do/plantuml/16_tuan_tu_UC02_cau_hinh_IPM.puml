@startuml 16_tuan_tu_UC02_cau_hinh_IPM
!pragma layout smetana
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 14
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #1F1F1F
skinparam ArrowFontSize 13
skinparam RoundCorner 12
skinparam ActorBorderColor #1F1F1F
skinparam ActorBackgroundColor #FFFFFF
skinparam UsecaseBorderColor #1F1F1F
skinparam UsecaseBackgroundColor #F4F8FD
skinparam RectangleBorderColor #1F1F1F
skinparam RectangleFontStyle bold
skinparam PackageBorderColor #5A5A5A
skinparam PackageBackgroundColor #FAFBFC
skinparam ClassBorderColor #1F1F1F
skinparam ClassBackgroundColor #F4F8FD
skinparam ClassHeaderBackgroundColor #E3ECF6
skinparam ClassAttributeIconSize 0
skinparam ActivityBorderColor #1F1F1F
skinparam ActivityBackgroundColor #F4F8FD
skinparam ActivityDiamondBorderColor #1F1F1F
skinparam ActivityDiamondBackgroundColor #FFFFFF
skinparam SwimlaneBorderColor #1F1F1F
skinparam SwimlaneTitleFontStyle bold
skinparam SwimlaneTitleBackgroundColor #EEF2F7
skinparam ParticipantBorderColor #1F1F1F
skinparam ParticipantBackgroundColor #F4F8FD
skinparam SequenceLifeLineBorderColor #7A7A7A
skinparam SequenceGroupBorderColor #5A5A5A
skinparam SequenceGroupHeaderFontStyle bold
skinparam NoteBorderColor #9A8A3A
skinparam NoteBackgroundColor #FFFBE6
skinparam StateBorderColor #1F1F1F
skinparam StateBackgroundColor #F4F8FD
skinparam ComponentBorderColor #1F1F1F
skinparam ComponentBackgroundColor #F4F8FD
skinparam DatabaseBorderColor #1F1F1F
skinparam DatabaseBackgroundColor #FFFFFF
skinparam NodeBorderColor #1F1F1F
skinparam NodeBackgroundColor #FAFBFC
skinparam ArtifactBackgroundColor #FFFFFF
skinparam EntityBorderColor #1F1F1F
skinparam EntityBackgroundColor #F4F8FD
autonumber
actor "Người dùng" as U
participant "MainWindow" as MW
participant "ProcessingWorker" as W
participant "CalibrationDialog" as CD
participant "_AutoCalibThread" as AT
participant "autocalib\n(adas.distance)" as AC
participant "GroundPlaneMapper" as M
participant "AppConfig" as CFG
database "Database" as DB

U -> MW : "Căn chỉnh camera"
alt Đang giám sát
  MW -> W : last_frame
else Chưa chạy
  MW -> MW : read_first_frame(source) hoặc hộp chọn file
end
MW -> W : set_paused(True)
MW -> CD : CalibrationDialog(frame, cfg.calibration, video_path, speed)
alt Thủ công
  U -> CD : chấm / kéo 4 điểm, nhập W, L, d0, nửa làn, tầm đo
else Tự động (nguồn là file video)
  U -> CD : "Tự động căn chỉnh", nhập tốc độ xe trong video
  CD -> AT : start()
  AT -> AC : auto_calibrate(video, speed, base, lane_w, offset)
  AC -> AC : điểm tụ (Hough + RANSAC), chiều cao camera, K = f·h
  AC --> AT : CalibrationConfig, AutoCalibReport
  AT --> CD : done → _apply_auto(): 4 điểm, method = auto
end
loop Mỗi lần đổi điểm / thông số
  CD -> M : GroundPlaneMapper(calib, frame_size)
  M --> CD : H, horizon_y, model (K, R, f, chiều cao, góc chúc)
  CD --> U : xem trước Bird's-Eye View (lưới 10 m)
end
U -> CD : "Áp dụng"
CD --> MW : result_calib, method, note
MW -> CFG : update_inplace(cfg.calibration, result_calib)
MW -> CFG : save("Căn chỉnh camera (IPM)")
CFG -> DB : save_config() → system_config + config_history
MW -> DB : register_source(video_path)
MW -> DB : save_calibration(source_id, params, frame_size, method, note)
DB -> M : model: phân rã H → K, R
DB --> MW : id ma trận camera
MW -> W : calibration_changed()
MW -> W : set_paused(False)
W -> W : khung kế tiếp: pipeline.update_calibration()
MW --> U : "Đã lưu ma trận camera #id cho nguồn …"
@enduml
