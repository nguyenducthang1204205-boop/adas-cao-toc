@startuml 26_hoat_dong_xu_ly_mot_khung
!pragma layout smetana
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 14
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #1F1F1F
skinparam ArrowFontSize 13
skinparam RoundCorner 12
skinparam ActorBorderColor #1F1F1F
skinparam ActorBackgroundColor #FFFFFF
skinparam UsecaseBorderColor #1F1F1F
skinparam UsecaseBackgroundColor #F4F8FD
skinparam RectangleBorderColor #1F1F1F
skinparam RectangleFontStyle bold
skinparam PackageBorderColor #5A5A5A
skinparam PackageBackgroundColor #FAFBFC
skinparam ClassBorderColor #1F1F1F
skinparam ClassBackgroundColor #F4F8FD
skinparam ClassHeaderBackgroundColor #E3ECF6
skinparam ClassAttributeIconSize 0
skinparam ActivityBorderColor #1F1F1F
skinparam ActivityBackgroundColor #F4F8FD
skinparam ActivityDiamondBorderColor #1F1F1F
skinparam ActivityDiamondBackgroundColor #FFFFFF
skinparam SwimlaneBorderColor #1F1F1F
skinparam SwimlaneTitleFontStyle bold
skinparam SwimlaneTitleBackgroundColor #EEF2F7
skinparam ParticipantBorderColor #1F1F1F
skinparam ParticipantBackgroundColor #F4F8FD
skinparam SequenceLifeLineBorderColor #7A7A7A
skinparam SequenceGroupBorderColor #5A5A5A
skinparam SequenceGroupHeaderFontStyle bold
skinparam NoteBorderColor #9A8A3A
skinparam NoteBackgroundColor #FFFBE6
skinparam StateBorderColor #1F1F1F
skinparam StateBackgroundColor #F4F8FD
skinparam ComponentBorderColor #1F1F1F
skinparam ComponentBackgroundColor #F4F8FD
skinparam DatabaseBorderColor #1F1F1F
skinparam DatabaseBackgroundColor #FFFFFF
skinparam NodeBorderColor #1F1F1F
skinparam NodeBackgroundColor #FAFBFC
skinparam ArtifactBackgroundColor #FFFFFF
skinparam EntityBorderColor #1F1F1F
skinparam EntityBackgroundColor #F4F8FD
|(2) Nhận diện (adas/detection)|
start
:Nhận khung BGR và thời điểm t;
:Tính N = YOLO mỗi N khung
(cấu hình, hoặc tự động ≤ nửa thời gian một khung);
if (Khung chạy YOLO?) then (Có)
  :VehicleDetector.detect: YOLOv11 + ByteTrack
  → khung bao, lớp, độ tin cậy, mã bám vết;
  :N > 1: neo mẫu cho các khung bám vết sau;
else (Không - khung giữa)
  :TemplateTracker.track: so khớp mẫu NCC
  (NCC < 0,6 → chỉ dự đoán);
endif
|(3) Khoảng cách (adas/distance)|
if (auto_lane hoặc auto_speed?) then (Có)
  :EgoLaneDetector.update: BEV mét, top-hat, che hộp xe,
  cửa sổ trượt, X = c0 + c1·Y + c2·Y² (3 khung để xác nhận);
else (Không)
endif
if (auto_speed?) then (Có)
  :EgoSpeedEstimator.update: tương quan vạch đứt
  giữa hai khung → v, trung vị 1 s, làm mượt;
else (Không)
endif
:Tốc độ = tốc độ đo được, hoặc tốc độ chọn tay;
:Với mỗi xe: điểm chạm đất = giữa cạnh dưới khung bao;
if (Dưới chân trời và ≤ tầm đo tối đa?) then (Có)
  :IPM: image_to_ground → Y (khoảng cách), X (lệch ngang);
else (Không)
  :Pinhole với tiêu cự từ H, method = "Xa";
endif
:RangeKalman theo mã bám vết [d, d', d'']
→ khoảng cách, tốc độ tiếp cận, TTC;
:in_ego_lane = làn chứa (X, Y) hoặc |X| ≤ nửa làn;
|(4) Cảnh báo (adas/alert)|
:compute_thresholds(tốc độ, chính sách)
→ ngưỡng cảnh báo, ngưỡng nguy hiểm;
if (Ngoài làn hoặc "Xa"?) then (Có)
  :risk = info (không cảnh báo);
else (Không)
  :classify_risk: nguy hiểm nếu d < ngưỡng nguy hiểm hoặc TTC < TTC nguy hiểm,
  cảnh báo nếu d < ngưỡng cảnh báo hoặc TTC < TTC cảnh báo, còn lại an toàn;
endif
:raw_level = mức cao nhất, xe phía trước = xe cùng làn gần nhất;
:AlertManager.update: nâng mức khi kéo dài ≥ 0,1 s (≥ 2 khung),
hạ mức sau 0,8 s, phát bíp theo mức;
:Trả FrameResult;
stop
@enduml
