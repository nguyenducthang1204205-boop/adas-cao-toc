@startuml 17_tuan_tu_UC03_nguong_canh_bao
!pragma layout smetana
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 14
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #1F1F1F
skinparam ArrowFontSize 13
skinparam RoundCorner 12
skinparam ActorBorderColor #1F1F1F
skinparam ActorBackgroundColor #FFFFFF
skinparam UsecaseBorderColor #1F1F1F
skinparam UsecaseBackgroundColor #F4F8FD
skinparam RectangleBorderColor #1F1F1F
skinparam RectangleFontStyle bold
skinparam PackageBorderColor #5A5A5A
skinparam PackageBackgroundColor #FAFBFC
skinparam ClassBorderColor #1F1F1F
skinparam ClassBackgroundColor #F4F8FD
skinparam ClassHeaderBackgroundColor #E3ECF6
skinparam ClassAttributeIconSize 0
skinparam ActivityBorderColor #1F1F1F
skinparam ActivityBackgroundColor #F4F8FD
skinparam ActivityDiamondBorderColor #1F1F1F
skinparam ActivityDiamondBackgroundColor #FFFFFF
skinparam SwimlaneBorderColor #1F1F1F
skinparam SwimlaneTitleFontStyle bold
skinparam SwimlaneTitleBackgroundColor #EEF2F7
skinparam ParticipantBorderColor #1F1F1F
skinparam ParticipantBackgroundColor #F4F8FD
skinparam SequenceLifeLineBorderColor #7A7A7A
skinparam SequenceGroupBorderColor #5A5A5A
skinparam SequenceGroupHeaderFontStyle bold
skinparam NoteBorderColor #9A8A3A
skinparam NoteBackgroundColor #FFFBE6
skinparam StateBorderColor #1F1F1F
skinparam StateBackgroundColor #F4F8FD
skinparam ComponentBorderColor #1F1F1F
skinparam ComponentBackgroundColor #F4F8FD
skinparam DatabaseBorderColor #1F1F1F
skinparam DatabaseBackgroundColor #FFFFFF
skinparam NodeBorderColor #1F1F1F
skinparam NodeBackgroundColor #FAFBFC
skinparam ArtifactBackgroundColor #FFFFFF
skinparam EntityBorderColor #1F1F1F
skinparam EntityBackgroundColor #F4F8FD
autonumber
actor "Người dùng" as U
participant "ConditionPanel /\nChatPanel" as CP
participant "MainWindow" as MW
participant "_AssistantTask\n(QThreadPool)" as T
participant "SafetyAssistant" as SA
participant "Claude API" as API
participant "thresholds\n(adas.alert)" as TH
participant "AppConfig" as CFG
database "Database" as DB

U -> CP : bấm nút điều kiện (vd "Mưa to") hoặc gõ mô tả
CP -> MW : send_requested(text)
MW -> T : ask_assistant(text): policy, speed_kmh, scene
T -> SA : ask(message, policy, speed_kmh, scene)
alt use_cloud = False (mặc định)
  SA -> SA : offline_advice(): từ khóa tiếng Việt
  SA -> TH : condition_policy(key, modifiers, visibility, base = policy)
else use_cloud = True
  SA -> API : messages.create(system, messages, output_config json_schema)
  alt Thành công
    API --> SA : JSON: reply, policy, speed_kmh
  else Lỗi mạng / API key / từ chối
    SA -> SA : offline_advice() + ghi chú lỗi
  end
end
SA -> SA : clamp_policy() theo LIMITS (giữ band_gaps_m, time_gap_s)
SA --> T : AssistantResult(reply, policy, speed_kmh, source)
T --> MW : done(result)
MW -> CFG : update_inplace(cfg.policy, result.policy)
opt Tài xế có nêu tốc độ
  MW -> MW : speed_panel.set_speed(v), tắt tự đo
end
MW -> TH : compute_thresholds(speed_kmh, policy)
TH --> MW : Thresholds(safe_m, danger_m, legal_m, band_m)
MW --> U : "Đã áp dụng … cảnh báo < X m, nguy hiểm < Y m"
MW -> CFG : save("Trợ lý AI (nguồn): điều kiện")
CFG -> DB : system_config + config_history
note over MW, CFG : ProcessingWorker đọc cfg.policy ở khung kế tiếp
opt Chỉnh trong Cài đặt
  U -> MW : "Cài đặt" → SettingsDialog (5 tab) → "Lưu"
  MW -> CFG : update_inplace(cfg, dlg.cfg), save("Cài đặt hệ thống")
end
@enduml
