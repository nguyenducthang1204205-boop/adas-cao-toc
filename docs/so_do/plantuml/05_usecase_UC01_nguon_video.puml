left to right direction
actor "Người dùng" as user
actor "Camera /\nnguồn video" as cam

rectangle "Hệ thống cảnh báo khoảng cách an toàn" {
  usecase "UC01. Quản lý nguồn\nvideo/camera" as base
  usecase "Xem danh sách nguồn" as s1
  usecase "Thêm file video / ảnh" as s2
  usecase "Thêm camera USB /\nURL RTSP-HTTP" as s3
  usecase "Dò camera USB (chỉ số 0-4)" as s4
  usecase "Kiểm tra kết nối\n& xem trước" as s5
  usecase "Sửa thông tin nguồn" as s6
  usecase "Xóa nguồn" as s7
  usecase "Mở nguồn để giám sát" as s8
  usecase "Mở nhanh: video / ảnh /\ncamera / nguồn gần đây" as s9
}

user -- base
base ..> s1 : <<include>>
base <.. s2 : <<extend>>
base <.. s3 : <<extend>>
base <.. s4 : <<extend>>
base <.. s5 : <<extend>>
base <.. s6 : <<extend>>
base <.. s7 : <<extend>>
base <.. s8 : <<extend>>
base <.. s9 : <<extend>>
s4 -- cam
s5 -- cam
@enduml
