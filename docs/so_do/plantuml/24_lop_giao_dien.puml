@startuml 24_lop_giao_dien
!pragma layout smetana
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 14
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #1F1F1F
skinparam ArrowFontSize 13
skinparam RoundCorner 12
skinparam ActorBorderColor #1F1F1F
skinparam ActorBackgroundColor #FFFFFF
skinparam UsecaseBorderColor #1F1F1F
skinparam UsecaseBackgroundColor #F4F8FD
skinparam RectangleBorderColor #1F1F1F
skinparam RectangleFontStyle bold
skinparam PackageBorderColor #5A5A5A
skinparam PackageBackgroundColor #FAFBFC
skinparam ClassBorderColor #1F1F1F
skinparam ClassBackgroundColor #F4F8FD
skinparam ClassHeaderBackgroundColor #E3ECF6
skinparam ClassAttributeIconSize 0
skinparam ActivityBorderColor #1F1F1F
skinparam ActivityBackgroundColor #F4F8FD
skinparam ActivityDiamondBorderColor #1F1F1F
skinparam ActivityDiamondBackgroundColor #FFFFFF
skinparam SwimlaneBorderColor #1F1F1F
skinparam SwimlaneTitleFontStyle bold
skinparam SwimlaneTitleBackgroundColor #EEF2F7
skinparam ParticipantBorderColor #1F1F1F
skinparam ParticipantBackgroundColor #F4F8FD
skinparam SequenceLifeLineBorderColor #7A7A7A
skinparam SequenceGroupBorderColor #5A5A5A
skinparam SequenceGroupHeaderFontStyle bold
skinparam NoteBorderColor #9A8A3A
skinparam NoteBackgroundColor #FFFBE6
skinparam StateBorderColor #1F1F1F
skinparam StateBackgroundColor #F4F8FD
skinparam ComponentBorderColor #1F1F1F
skinparam ComponentBackgroundColor #F4F8FD
skinparam DatabaseBorderColor #1F1F1F
skinparam DatabaseBackgroundColor #FFFFFF
skinparam NodeBorderColor #1F1F1F
skinparam NodeBackgroundColor #FAFBFC
skinparam ArtifactBackgroundColor #FFFFFF
skinparam EntityBorderColor #1F1F1F
skinparam EntityBackgroundColor #F4F8FD
set separator none
hide empty members
left to right direction

class MainWindow <<QMainWindow>> {
  +cfg : AppConfig
  +worker : Optional[ProcessingWorker]
  +assistant : SafetyAssistant
  +source_spec : str
  +source_id : int
  --
  +open_video() / open_image() / open_camera() / open_sources()
  +start() / toggle_pause() / stop()
  +calibrate() / open_settings() / open_history()
  +ask_assistant(text) / reset_policy() / toggle_sound()
  -_activate_source(spec) : int
  -_on_frame(overlay, bev, stats)
  -_policy_changed()
}
class ProcessingWorker <<QThread>> {
  +frame_ready : Signal(QImage, QImage, dict)
  +violation : Signal(dict)
  +session_started : Signal(int)
  +status / failed / progress : Signal
  +pipeline : ADASPipeline
  +last_frame : ndarray
  --
  +run() / stop() / set_paused(p)
  +calibration_changed() / classes_changed()
}

package "gui.dialogs" {
  class SourceDialog <<QDialog>> {
    +selected_uri : str
    --
    +refresh() / _add_file() / _add_other()
    +_edit() / _delete() / _test() / _scan() / _open()
  }
  class SourceEditDialog <<QDialog>>
  class CalibrationDialog <<QDialog>> {
    +result_calib : CalibrationConfig
    +method : str
    +note : str
    --
    -_update_preview() / _auto_calibrate() / _accept()
  }
  class CalibrationView
  class SettingsDialog <<QDialog>> {
    5 tab: Chung, Ngưỡng cảnh báo,
    Điều kiện đường, Trợ lý AI, Nâng cao
    --
    -_apply_preset() / _reset_bands() / _accept()
  }
  class HistoryDialog <<QDialog>> {
    +restore_config : Signal(dict)
    --
    +refresh() / _export_csv()
    +_delete_violations() / _delete_session() / _restore()
  }
}

package "gui.widgets" {
  class ImageView <<QWidget>> {
    +set_image(img) / image_rect()
  }
  class VideoStage {
    +show_welcome(on) / set_frames(overlay, bev)
  }
  class WelcomePanel
  class PlayBar
  class StatusCard {
    +set_level(level) / update_stats(s) / reset()
  }
  class SpeedPanel {
    +speed_changed : Signal(float)
    +auto_changed : Signal(bool)
    --
    +set_speed(v) / set_auto(on) / set_measured(v)
  }
  class ConditionPanel {
    +preset_requested : Signal(str)
    +reset_requested : Signal()
  }
  class ChatPanel {
    +send_requested : Signal(str)
    --
    +submit(text) / add_message() / set_busy()
  }
  class EventLog {
    +history_requested : Signal()
    --
    +start_session(id) / on_violation(e) / export_csv()
  }
}

MainWindow "1" --> "0..1" ProcessingWorker
MainWindow *-- VideoStage
MainWindow *-- PlayBar
MainWindow *-- StatusCard
MainWindow *-- SpeedPanel
MainWindow *-- ConditionPanel
MainWindow *-- ChatPanel
MainWindow *-- EventLog
VideoStage *-- WelcomePanel
VideoStage *-- "2" ImageView : video, BEV
ImageView <|-- CalibrationView
CalibrationDialog *-- CalibrationView
SourceDialog ..> SourceEditDialog
MainWindow ..> SourceDialog
MainWindow ..> CalibrationDialog
MainWindow ..> SettingsDialog
MainWindow ..> HistoryDialog
@enduml
