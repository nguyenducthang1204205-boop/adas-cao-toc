@startuml 18_tuan_tu_UC04_giam_sat
!pragma layout smetana
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 14
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #1F1F1F
skinparam ArrowFontSize 13
skinparam RoundCorner 12
skinparam ActorBorderColor #1F1F1F
skinparam ActorBackgroundColor #FFFFFF
skinparam UsecaseBorderColor #1F1F1F
skinparam UsecaseBackgroundColor #F4F8FD
skinparam RectangleBorderColor #1F1F1F
skinparam RectangleFontStyle bold
skinparam PackageBorderColor #5A5A5A
skinparam PackageBackgroundColor #FAFBFC
skinparam ClassBorderColor #1F1F1F
skinparam ClassBackgroundColor #F4F8FD
skinparam ClassHeaderBackgroundColor #E3ECF6
skinparam ClassAttributeIconSize 0
skinparam ActivityBorderColor #1F1F1F
skinparam ActivityBackgroundColor #F4F8FD
skinparam ActivityDiamondBorderColor #1F1F1F
skinparam ActivityDiamondBackgroundColor #FFFFFF
skinparam SwimlaneBorderColor #1F1F1F
skinparam SwimlaneTitleFontStyle bold
skinparam SwimlaneTitleBackgroundColor #EEF2F7
skinparam ParticipantBorderColor #1F1F1F
skinparam ParticipantBackgroundColor #F4F8FD
skinparam SequenceLifeLineBorderColor #7A7A7A
skinparam SequenceGroupBorderColor #5A5A5A
skinparam SequenceGroupHeaderFontStyle bold
skinparam NoteBorderColor #9A8A3A
skinparam NoteBackgroundColor #FFFBE6
skinparam StateBorderColor #1F1F1F
skinparam StateBackgroundColor #F4F8FD
skinparam ComponentBorderColor #1F1F1F
skinparam ComponentBackgroundColor #F4F8FD
skinparam DatabaseBorderColor #1F1F1F
skinparam DatabaseBackgroundColor #FFFFFF
skinparam NodeBorderColor #1F1F1F
skinparam NodeBackgroundColor #FAFBFC
skinparam ArtifactBackgroundColor #FFFFFF
skinparam EntityBorderColor #1F1F1F
skinparam EntityBackgroundColor #F4F8FD
autonumber
actor "Người dùng" as U
participant "MainWindow" as MW
participant "ProcessingWorker" as W
participant "FrameSource" as FS
participant "ADASPipeline" as P
participant "VehicleDetector /\nTemplateTracker" as VD
participant "EgoLaneDetector /\nEgoSpeedEstimator" as LD
participant "DistanceEstimator\n(+ RangeKalman)" as DE
participant "AlertManager" as AM
participant "ViolationRecorder" as VR
database "Database" as DB

U -> MW : "Bắt đầu" (F5)
MW -> DB : register_source(), latest_calibration()
MW -> W : ProcessingWorker(cfg, source, record, source_id).start()
W -> FS : open_source(spec, realtime)
W -> VD : VehicleDetector(best.pt, …), warmup()
W -> FS : read() → khung đầu
W -> P : ADASPipeline(cfg, detector, (w, h))
W -> DB : start_session(…, config) → session_id
W --> MW : session_started(session_id)
loop Mỗi khung (đến khi dừng / hết video)
  W -> P : process(frame, t)
  alt Khung chạy YOLO (mỗi N khung)
    P -> VD : detect(frame) [+ tracker.refresh() nếu N > 1]
  else Khung giữa
    P -> VD : tracker.track(gray, t) - so khớp mẫu NCC
  end
  VD --> P : List[Detection]
  P -> LD : lane_detector.update(frame, boxes)
  P -> LD : speed_estimator.update(frame, lane, t)
  LD --> P : LaneEstimate | None, tốc độ đo được | None
  P -> DE : estimate(detections, t, lane)
  DE --> P : List[VehicleState] (d, X, tốc độ tiếp cận, TTC)
  P -> P : compute_thresholds(speed) + classify_risk()
  P -> AM : update(raw_level)
  AM --> P : level ổn định (+ bíp)
  P --> W : FrameResult
  W -> VR : update(result, t, speed, condition, save_snapshot)
  opt Mở / cập nhật / đóng đợt vi phạm
    VR -> DB : insert_violation() / update_violation()
    VR --> W : sự kiện open / update / close
    W --> MW : violation(event)
  end
  W -> W : render_overlay() + render_bev()
  W --> MW : frame_ready(overlay, bev, stats), progress()
  MW --> U : video, BEV, thẻ trạng thái, thời gian 5 tầng
  W -> FS : read()
end
U -> MW : "Dừng" (Esc)
MW -> W : stop(), wait()
W -> VR : close(t)
W -> DB : end_session(session_id, frames, avg_fps)
W --> MW : status("Phiên #id: đã ghi n vi phạm vào CSDL")
@enduml
