<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: SplashScreen hệ thống - nền đen OLED + icon thích ứng của app -->
    <style name="Theme.Adas" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/adas_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowBackground">@color/adas_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
